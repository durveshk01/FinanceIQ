# Server-side OpenAI key. Never expose this in browser code.
OPENAI_API_KEY=

# Optional model override for analysis/chat routes.
OPENAI_MODEL=gpt-4.1-mini

# Public app URL used by Next.js metadata and deployment previews.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public product name.
NEXT_PUBLIC_SITE_NAME=FinanceIQ

# Placeholder flag for future analytics integration.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
