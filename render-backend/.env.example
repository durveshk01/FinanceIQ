NODE_ENV=development
PORT=4000
# Set a private, random secret of at least 32 characters for production.
JWT_SECRET=
# Mount this directory on a persistent volume for hosted deployments.
DATA_DIRECTORY=./data
ALLOW_CORS_ORIGIN=*
# On Render only, set 1 for its single trusted ingress proxy. Default: no proxy.
TRUST_PROXY_HOPS=0
