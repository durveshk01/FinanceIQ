{
  "name": "financeiq",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.js && next dev",
    "build": "node scripts/prepare-assets.js && next build",
    "prepare:assets": "node scripts/prepare-assets.js",
    "build:export": "node scripts/build-export.js",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src scripts tests render-backend/src *.json *.ts *.mjs *.md .github/workflows",
    "format:check": "prettier --check src scripts tests render-backend/src *.json *.ts *.mjs *.md .github/workflows",
    "audit:repository": "node scripts/audit-repository.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/lib/finance-engine.test.ts",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "test:regression": "tsx src/lib/regression.test.ts",
    "test:browser": "node scripts/verify-browser.js",
    "test:browser:static": "node scripts/verify-browser.js --static",
    "test:android": "tsx scripts/verify-android.ts",
    "test:release": "tsx --test tests/release-gates.test.ts",
    "test:all": "npm run test && npm run test:regression && npm run test:e2e && npm run test:release && npm --prefix render-backend test",
    "build:android": "node scripts/build-android.js",
    "android:signing": "node scripts/setup-android-signing.js",
    "start:backend": "npm --prefix render-backend start"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "16.4.6",
    "openai": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
